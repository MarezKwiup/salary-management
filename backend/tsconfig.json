{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "types": ["node"],
        "sourceMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "strict": true,
        "verbatimModuleSyntax": false,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true
    },
    "include": ["src"]
}
